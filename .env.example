# HarborWatch 3D local configuration. Copy to .env and adjust.

# Optional. When empty, the console uses the built-in 3D harbor scene.
# When set, the web client loads ArcGIS SceneView with the same track store.
ARCGIS_API_KEY=
VITE_ARCGIS_API_KEY=

# API
PORT=5000
JWT_SECRET=harborwatch-dev-jwt-change-me
INGEST_KEY=harborwatch-ingest-dev
STALE_MS=15000
EXPIRE_MS=45000
LOG_LEVEL=info

# PostgreSQL. Use memory:// to run the API without Docker.
DATABASE_URL=postgres://harborwatch:harborwatch@localhost:5432/harborwatch

# Simulator
API_URL=http://localhost:5000
SITE_IDS=alder-harbor,cedar-inlet
TRACK_COUNT=48
SIMULATOR_PORT=8000

# Demo identity (local adapter). Hosted environments should use OIDC.
AUTH_ADAPTER=local
